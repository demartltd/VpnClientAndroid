# OS / editor
.DS_Store
*.swp
.history

# IDE
.idea/
.vscode/
*.iml
.cxx/

# Local tooling (not in git)
scripts/

# Android / Gradle local
local.properties
.gradle/
.kotlin/
captures/

# Build outputs
**/build/
*.apk
*.aab
*.hprof

# Libbox (scripts/libbox-build-android.py)
app/libs/libbox.aar
app/src/main/jniLibs/

# Sing-box assets — only bundled_version.txt (+ optional README) in git
**/singbox/*
!**/singbox/bundled_version.txt
!**/singbox/README.txt
!**/singbox/README.md

# Ads rule-set — fetched by scripts/build_android.ps1 before release
app/src/main/assets/rule-sets/*.srs

# OpenFlux sidecar binary — scripts/openflux-build-android.sh
app/src/main/assets/openflux/openflux-arm64

# Release signing — readme-signing.md
key.properties
**/*.jks
**/*.keystore

# Python tooling
.venv/

# Docs (generated screenshots)
docs/

# Misc
*.class
*.log
*.pyc
*.sync-conflict-*
